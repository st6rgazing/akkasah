# Akkasah Archive - Environment Configuration
# Copy this file to .env and update the values

# Database Configuration
DATABASE_URL=sqlite:///./akkasah_archive.db
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost/akkasah_archive

# Security Configuration
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-characters
DEBUG=False
ENVIRONMENT=production

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "https://yourdomain.com"]

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_EXTENSIONS=[".jpg", ".jpeg", ".png", ".gif", ".tiff", ".webp"]
UPLOAD_DIRECTORY=./uploads

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/akkasah.log

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=True

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379/0

# Monitoring and Analytics
SENTRY_DSN=your-sentry-dsn-here
GOOGLE_ANALYTICS_ID=your-ga-id-here

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket

# API Configuration
API_V1_PREFIX=/api/v1
DOCS_URL=/api/docs
REDOC_URL=/api/redoc
OPENAPI_URL=/api/openapi.json

# Cache Configuration
CACHE_TTL=3600  # 1 hour in seconds
CACHE_MAX_SIZE=1000

# Security Headers
HSTS_MAX_AGE=31536000
CSP_REPORT_URI=/api/security/csp-report

# Admin Configuration
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD_HASH=your-admin-password-hash

# Feature Flags
ENABLE_REGISTRATION=False
ENABLE_EMAIL_VERIFICATION=True
ENABLE_TWO_FACTOR=False
ENABLE_API_DOCS=True
